__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# generated data / model artifacts (large / reproducible)
data/*.csv
data/*.parquet
data/raw/
data/cache/
data/chunks/
models/*.pkl
models/*.txt
models/*.joblib
models/*.csv

# data/jra_results.csv and data/oikiri.csv ARE tracked: both are raw
# scraped datasets, not reproducible without re-scraping (see
# scripts/scrape_oikiri.py for the latter's caveats). models/model_dirt.joblib
# and models/history.csv are NOT tracked -- both are fully reproducible from
# data/jra_results.csv (+ data/oikiri.csv) in seconds via
# scripts/train_model.py, and history.csv in particular is large (~5x the
# raw CSV, since it carries every derived feature column) for something with
# zero information not already in the raw data. See the weekly_update
# workflow / README for how CI publishes a fresh model as a downloadable
# artifact instead of committing it.
!data/jra_results.csv
!data/oikiri.csv
!data/.gitkeep
!models/.gitkeep
